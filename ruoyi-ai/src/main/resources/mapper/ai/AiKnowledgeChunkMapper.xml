<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.ai.mapper.AiKnowledgeChunkMapper">

    <resultMap type="AiKnowledgeChunk" id="AiKnowledgeChunkResult">
        <id     property="chunkId"        column="chunk_id"        />
        <result property="title"          column="title"           />
        <result property="moduleName"     column="module_name"     />
        <result property="sourceType"     column="source_type"     />
        <result property="sourceName"     column="source_name"     />
        <result property="content"        column="content"         />
        <result property="embeddingModel" column="embedding_model" />
        <result property="embeddingJson"  column="embedding_json"  />
        <result property="status"         column="status"          />
        <result property="createBy"       column="create_by"       />
        <result property="createTime"     column="create_time"     />
        <result property="updateBy"       column="update_by"       />
        <result property="updateTime"     column="update_time"     />
        <result property="remark"         column="remark"          />
    </resultMap>

    <sql id="selectKnowledgeChunkVo">
        select chunk_id, title, module_name, source_type, source_name, content, embedding_model, embedding_json,
               status, create_by, create_time, update_by, update_time, remark
        from ai_knowledge_chunk
    </sql>

    <select id="selectKnowledgeChunkList" parameterType="AiKnowledgeChunk" resultMap="AiKnowledgeChunkResult">
        <include refid="selectKnowledgeChunkVo"/>
        <where>
            <if test="title != null and title != ''">
                AND title like concat('%', #{title}, '%')
            </if>
            <if test="moduleName != null and moduleName != ''">
                AND module_name like concat('%', #{moduleName}, '%')
            </if>
            <if test="sourceName != null and sourceName != ''">
                AND source_name like concat('%', #{sourceName}, '%')
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
        </where>
        order by update_time desc, create_time desc, chunk_id desc
    </select>

    <select id="selectEnabledKnowledgeChunks" parameterType="String" resultMap="AiKnowledgeChunkResult">
        <include refid="selectKnowledgeChunkVo"/>
        where status = '0' and embedding_model = #{embeddingModel} and embedding_json is not null and embedding_json != ''
        order by chunk_id desc
    </select>

    <select id="selectKnowledgeChunkById" parameterType="Long" resultMap="AiKnowledgeChunkResult">
        <include refid="selectKnowledgeChunkVo"/>
        where chunk_id = #{chunkId}
    </select>

    <insert id="insertKnowledgeChunk" parameterType="AiKnowledgeChunk" useGeneratedKeys="true" keyProperty="chunkId">
        insert into ai_knowledge_chunk(
            title, module_name, source_type, source_name, content, embedding_model, embedding_json,
            status, remark, create_by, create_time
        )values(
            #{title}, #{moduleName}, #{sourceType}, #{sourceName}, #{content}, #{embeddingModel}, #{embeddingJson},
            #{status}, #{remark}, #{createBy}, sysdate()
        )
    </insert>

    <update id="updateKnowledgeChunk" parameterType="AiKnowledgeChunk">
        update ai_knowledge_chunk
        <set>
            <if test="title != null">title = #{title},</if>
            <if test="moduleName != null">module_name = #{moduleName},</if>
            <if test="sourceType != null">source_type = #{sourceType},</if>
            <if test="sourceName != null">source_name = #{sourceName},</if>
            <if test="content != null">content = #{content},</if>
            <if test="embeddingModel != null">embedding_model = #{embeddingModel},</if>
            <if test="embeddingJson != null">embedding_json = #{embeddingJson},</if>
            <if test="status != null">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where chunk_id = #{chunkId}
    </update>

    <delete id="deleteKnowledgeChunkByIds" parameterType="Long">
        delete from ai_knowledge_chunk
        where chunk_id in
        <foreach collection="array" item="chunkId" open="(" separator="," close=")">
            #{chunkId}
        </foreach>
    </delete>
</mapper>
