<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.ai.mapper.AiChatLogMapper">

    <resultMap type="AiChatLog" id="AiChatLogResult">
        <id     property="chatLogId"    column="chat_log_id"   />
        <result property="model"        column="model"         />
        <result property="prompt"       column="prompt"        />
        <result property="answer"       column="answer"        />
        <result property="status"       column="status"        />
        <result property="errorMessage" column="error_message" />
        <result property="matchedChunks" column="matched_chunks" />
        <result property="operName"     column="oper_name"     />
        <result property="createTime"   column="create_time"   />
        <result property="remark"       column="remark"        />
    </resultMap>

    <sql id="selectChatLogVo">
        select chat_log_id, model, prompt, answer, status, error_message, matched_chunks, oper_name, create_time, remark
        from ai_chat_log
    </sql>

    <select id="selectChatLogList" parameterType="AiChatLog" resultMap="AiChatLogResult">
        <include refid="selectChatLogVo"/>
        <where>
            <if test="model != null and model != ''">
                AND model = #{model}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
            <if test="operName != null and operName != ''">
                AND oper_name like concat('%', #{operName}, '%')
            </if>
            <if test="params.beginTime != null and params.beginTime != ''">
                AND date_format(create_time, '%Y%m%d') &gt;= date_format(#{params.beginTime}, '%Y%m%d')
            </if>
            <if test="params.endTime != null and params.endTime != ''">
                AND date_format(create_time, '%Y%m%d') &lt;= date_format(#{params.endTime}, '%Y%m%d')
            </if>
        </where>
        order by create_time desc, chat_log_id desc
    </select>

    <select id="selectChatLogById" parameterType="Long" resultMap="AiChatLogResult">
        <include refid="selectChatLogVo"/>
        where chat_log_id = #{chatLogId}
    </select>

    <insert id="insertChatLog" parameterType="AiChatLog" useGeneratedKeys="true" keyProperty="chatLogId">
        insert into ai_chat_log(
            model, prompt, answer, status, error_message, matched_chunks, oper_name, remark, create_time
        )values(
            #{model}, #{prompt}, #{answer}, #{status}, #{errorMessage}, #{matchedChunks}, #{operName}, #{remark}, sysdate()
        )
    </insert>
</mapper>
